# Validation croisée pour le degré du polynome
cv_poly <- function(degre, data, nfold=5){
n <- nrow(data)
folds <- cut(seq(1,n), breaks=nfold, labels=FALSE)
mse_fold <- numeric(nfold)
for (i in 1:nfold){
test_id  <- which(folds == i)
train_id <- which(folds != i)
train <- data[train_id, ]
test  <- data[test_id, ]
mod <- lm(areaPerMzloty ~ poly(construction.date, degre, raw = TRUE), data = train)
ypred <- predict(mod, newdata = test)
mse_fold[i] <- mean((test$areaPerMzloty - ypred)^2)
}
return(mean(mse_fold))
}
# grille des degré
degre_grid<-seq(1, 10)
CV_poly_errors <- sapply(degre_grid, cv_poly, data=appart)
best_degre <- degre_grid[which.min(CV_poly_errors)]
#Meilleur degré :
best_degre
plot(degre_grid, CV_poly_errors, type="b", pch=19, xlab="Degré du polynôme", ylab="Erreur CV",
main="Choix du degré par Validation Croisée")
abline(v=best_degre, col="red3", lty=2)
res_best_poly<-lm(y~poly(X, best_degre, raw = TRUE))
