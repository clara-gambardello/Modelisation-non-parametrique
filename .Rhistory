require(Ecdat)
data(Caschool)
Caschool$log.avginc<- log(Caschool$avginc)
fitGAMCaschool <- gam(mathscr~s(calwpct)+s(compstu)+s(expnstu)+s(log.avginc), data=Caschool)
summary(fitGAMCaschool)
par(mfrow=c(2,2),cex.main = 1.8, col.main = "navy",
cex.lab = 1,mai = c(0.7,0.68,0.1,0.05))
plot(fitGAMCaschool,select = 1,shade = TRUE,bty = "l",
xlab = "% califiés pour CalWORKs",
ylab = "effet sur le score moyen en math", shade.col = "palegreen",
rug = FALSE)
rug(Caschool$calwpct,col="dodgerblue")
plot(fitGAMCaschool,select = 2,shade = TRUE,bty = "l", xlab = "nombre d'ordinateurs par étudiant", ylab="effetsurlescoremoyenenmath",shade.col="palegreen", rug=FALSE)
rug(Caschool$log.avginc,col="dodgerblue")
plot(fitGAMCaschool,select=3,shade=TRUE,bty="l",
xlab="dépendesparétudiant",
ylab="effetsurlescoremoyenenmath",shade.col="palegreen",
rug=FALSE)
rug(Caschool$compstu,col="dodgerblue")
plot(fitGAMCaschool,select=4,shade=TRUE,bty="l",
cex.lab=1,xlab="log(revenumoyenpardistrict)",
ylab="effetsurlescoremoyenenmath",shade.col="palegreen",
rug=FALSE)
rug(Caschool$expnstu,col="dodgerblue")
fitLMCaschool <- gam(mathscr~calwpct+compstu+expnstu+log.avginc, data=Caschool)
summary(fitLMCaschool)
anova(fitLMCaschool,fitGAMCaschool,test="F")
fitLMCaschool2 <- gam(mathscr~s(calwpct)+compstu+expnstu+s(log.avginc), data=Caschool)
summary(fitLMCaschool2)
anova(fitLMCaschool2,fitGAMCaschool,test="F")
par(mfrow=c(2,2),cex.main = 1.8, col.main = "navy",
cex.lab = 1,mai = c(0.7,0.68,0.1,0.05))
plot(fitGAMCaschool,select = 1,shade = TRUE,bty = "l",
xlab = "% califiés pour CalWORKs",
rug = FALSE)
rug(Caschool$calwpct,col="dodgerblue")
plot(fitGAMCaschool,select = 2,shade = TRUE,bty = "l", xlab = "nombre d'ordinateurs par étudiant", rug=FALSE)
rug(Caschool$log.avginc,col="dodgerblue")
plot(fitGAMCaschool,select=3,shade=TRUE,bty="l",
xlab="dépendesparétudiant",
rug=FALSE)
rug(Caschool$compstu,col="dodgerblue")
plot(fitGAMCaschool,select=4,shade=TRUE,bty="l",
cex.lab=1,xlab="log(revenumoyenpardistrict)",
rug=FALSE)
rug(Caschool$expnstu,col="dodgerblue")
