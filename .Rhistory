lidar <- read.table("lidar.txt",header=T)
lidar$range <- (lidar$range-390)/(720-390) # On normalise la variable range
plot(logratio~range,data=lidar)
#df=dimension K+m de la base
#degree=degre m-1 du polynome
#intercept=TRUE pour avoir des fonctions B-spline de somme=1
require(splines)
#nombre de noeuds=df-degree-1=3
Bbase <- bs(lidar$range, df=5, degree=1, intercept=TRUE)
##les noeuds sont placés aux quantiles
attr(Bbase,"knots")
par(mfrow=c(2,3))
for(i in 1:ncol(Bbase)){
plot(lidar$range, Bbase[, i], type="l", xlab = "range", ylab = "fonction B splines")
}
res.bs<-lm(logratio~bs(range, df=8, degree=2, intercept=TRUE)-1, data=lidar)
summary(res.bs)
plot(lidar$range,lidar$logratio, xlab="range", ylab="logratio",
main='B-spline fitting of LIDAR data with K=5 and m=3')
lines(lidar$range, predict(res.bs), type="l",col="red")
K<-c(2, 5, 10)
col=c("red3", "magenta3", "aquamarine2")
m_1<-2
plot(lidar$range,lidar$logratio, xlab="range", ylab="logratio",
main='B-spline fitting of LIDAR data with K=5 and m=3')
for(i in 1:length(K)){
k<-K[i]
df<-m_1-1+k
Bbase<-bs(lidar$range, df=df, degree=m_1, intercept=TRUE)
res_2<-lm(logratio~Bbase-1, data=lidar)
lines(lidar$range, predict(res_2), type="l",col=col[i])
}
legend("topright", legend=c("K=2", "K=5", "K=10"), col=col, lwd=2)
K<-5
m_values<-c(3, 4, 5)
col<-c("red3", "magenta3", "aquamarine2")
plot(lidar$range, lidar$logratio, xlab="range", ylab="logratio",
main='B-spline fitting of LIDAR data for different m')
for(i in 1:length(m_values)){
m<-m_values[i]
df<-m-1+K
Bbase<-bs(lidar$range, df=df, degree=m, intercept=TRUE)
res<-lm(logratio~Bbase-1, data=lidar)
lines(lidar$range, predict(res), col=col[i])
}
legend("topright", legend=paste("m-1 =", m_values-1), col=col, lwd=2)
require(mgcv)
##bs pour avoir une base de B-splines,
##par defaut: polynomes de degré 3 et une pénalité sur la dérivée seconde:m=c(3,2)
##k=5 la dimension de la base; par defaut =10
res.fit <- gam(logratio~s(range,bs="bs",k=5,m=c(3,2)), data=lidar)
summary(res.fit)
##les valeurs du parametre de lissage
res.fit$sp
##graphique avec les CI
plot(res.fit,shade=TRUE,seWithMean=TRUE,scale=0)
